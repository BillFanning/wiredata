<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example Task Scheduler task: start an unattended listener when Windows starts
  (listener spec §3.1). See deploy/README.md. Adjust the Command, Arguments and
  WorkingDirectory paths, then register it from an elevated PowerShell:

    Register-ScheduledTask -TaskName "wiredata listener" -Xml (Get-Content -Raw .\listener-task.xml)
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>wiredata listener: record serial and network data streams.</Description>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger>
      <Enabled>true</Enabled>
      <!-- Let USB adapters enumerate first. A late one is retried anyway. -->
      <Delay>PT30S</Delay>
    </BootTrigger>
  </Triggers>
  <Principals>
    <Principal id="Listener">
      <!-- SYSTEM: runs whether or not anyone is signed in. -->
      <UserId>S-1-5-18</UserId>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <!-- Run until stopped: no time limit. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <!-- Restart after a crash or an internal error. -->
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Listener">
    <Exec>
      <Command>C:\Program Files\wiredata\listener.exe</Command>
      <Arguments>--profile "C:\ProgramData\wiredata\listener-profile.toml"</Arguments>
      <WorkingDirectory>C:\ProgramData\wiredata</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
